{
  "name": "mix2-workspace",
  "private": true,
  "scripts": {
    "dev": "pnpm build:core && pnpm --filter mix2 dev",
    "build": "pnpm build:core:release && pnpm --filter mix2 build",
    "build:core": "cargo build",
    "build:core:release": "cargo build --release",
    "test": "pnpm --filter mix2 test",
    "typecheck": "pnpm --filter mix2 typecheck",
    "check": "pnpm typecheck && pnpm test && cargo fmt --check && cargo clippy --all-targets --all-features -- -D warnings && cargo test"
  },
  "packageManager": "pnpm@11.9.0"
}
