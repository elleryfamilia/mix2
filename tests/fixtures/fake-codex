#!/usr/bin/env python3
"""Fake OpenAI Codex CLI for mix2 tests.

Speaks the same JSONL shape as `codex exec --json`. Scenario markers match
fake-claude (see that file). Final text carries the same bracketed markers:
  [session:<id>] [resumed:yes|no] [role:lead|teammate|none]
"""
import json
import os
import subprocess
import sys
import time
import uuid


def out(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def main():
    args = sys.argv[1:]
    if "--version" in args:
        print("codex-cli 9.9.9-fake")
        return 0

    if args[:2] == ["login", "status"]:
        if os.environ.get("FAKE_CODEX_LOGGED_OUT") == "1":
            print("Not logged in")
            return 1
        print("Logged in using ChatGPT")
        return 0

    if not args or args[0] != "exec":
        sys.stderr.write("fake-codex: expected `exec` subcommand\n")
        return 2

    rest = args[1:]
    resume_id = None
    if rest and rest[0] == "resume":
        resume_id = rest[1] if len(rest) > 1 and not rest[1].startswith("-") else None
        rest = rest[2:] if resume_id else rest[1:]

    dev_instructions = ""
    sandbox_mode = ""
    model = "default"
    for i, a in enumerate(rest):
        if a == "-c" and i + 1 < len(rest):
            kv = rest[i + 1]
            if kv.startswith("developer_instructions="):
                dev_instructions = kv.split("=", 1)[1]
            if kv.startswith("sandbox_mode="):
                sandbox_mode = kv.split("=", 1)[1]
            if kv.startswith("model="):
                model = kv.split("=", 1)[1].strip('"')

    prompt = sys.stdin.read()
    scenarios = _leading_scenarios(prompt)

    if "fail" in scenarios:
        sys.stderr.write("fake-codex: simulated provider failure (401 unauthorized)\n")
        return 1

    thread_id = resume_id or str(uuid.uuid4())
    resumed = "yes" if resume_id else "no"
    if "coordinate the team" in dev_instructions:
        role = "lead"
    elif "consulting engineer" in dev_instructions:
        role = "teammate"
    else:
        role = "none"

    out({"type": "thread.started", "thread_id": thread_id})
    out({"type": "turn.started"})

    if "rate_limit" in scenarios:
        out({"type": "turn.failed", "error": {"message": "Rate limit exceeded. Retry later."}})
        return 1

    if "malformed" in scenarios:
        sys.stdout.write("%%% not json %%%\n")
        sys.stdout.flush()

    if "spawn_child" in scenarios:
        child = subprocess.Popen(["sleep", "600"])
        pidfile = _extract(prompt, "PIDFILE:")
        if pidfile:
            with open(pidfile, "w") as f:
                f.write(f"{os.getpid()}\n{child.pid}\n")

    if "slow" in scenarios:
        time.sleep(120)

    out({"type": "item.started", "item": {
        "id": "item_0", "type": "command_execution", "command": "rg SessionManager src/",
    }})
    out({"type": "item.completed", "item": {
        "id": "item_0", "type": "command_execution", "command": "rg SessionManager src/",
        "exit_code": 0, "aggregated_output": "14 matches",
    }})

    consult_notes = []
    if "consult_async" in scenarios:
        consult_prompt = _extract(prompt, "CONSULT_PROMPT:") or "Quick take: evaluate the plan."
        try:
            proc = subprocess.run(
                ["mix2-consult", "start"], input=consult_prompt, text=True,
                capture_output=True, timeout=60,
            )
            ticket = ""
            for line in proc.stdout.splitlines():
                if line.startswith("ticket:"):
                    ticket = line.split(":", 1)[1].strip()
                    break
            if not ticket:
                consult_notes.append(f"[consult1:err:no-ticket:{proc.stdout.strip()[:120]}]")
            else:
                # Simulate the lead doing its own research concurrently.
                time.sleep(0.3)
                consult_notes.append("[own-research:done]")
                done = subprocess.run(
                    ["mix2-consult", "wait", ticket], text=True,
                    capture_output=True, timeout=300,
                )
                status = "ok" if done.returncode == 0 else "err"
                consult_notes.append(f"[consult1:{status}:{done.stdout.strip()}]")
        except Exception as e:  # noqa: BLE001 - fixture reports all failures
            consult_notes.append(f"[consult1:exc:{e}]")

    n_consults = 0
    if "consult_thrice" in scenarios:
        n_consults = 3
    elif "consult_twice" in scenarios:
        n_consults = 2
    elif "consult" in scenarios:
        n_consults = 1
    for i in range(n_consults):
        consult_prompt = (
            _extract(prompt, f"CONSULT_PROMPT{i + 1}:")
            or _extract(prompt, "CONSULT_PROMPT:")
            or "Independently evaluate the plan."
        )
        try:
            proc = subprocess.run(
                ["mix2-consult"], input=consult_prompt, text=True,
                capture_output=True, timeout=300,
            )
            reply = proc.stdout.strip()
            status = "ok" if proc.returncode == 0 else "err"
            consult_notes.append(f"[consult{i + 1}:{status}:{reply}]")
        except Exception as e:  # noqa: BLE001 - fixture reports all failures
            consult_notes.append(f"[consult{i + 1}:exc:{e}]")

    text = (
        f"fake-codex reply [session:{thread_id}] [resumed:{resumed}] [role:{role}] "
        f"[sandbox:{sandbox_mode or 'default'}] [model:{model}] " + " ".join(consult_notes)
    ).strip()

    out({"type": "item.completed", "item": {"id": "item_1", "type": "agent_message", "text": text}})
    out({"type": "turn.completed", "usage": {"input_tokens": 20, "output_tokens": len(text) // 4}})
    return 0


def _leading_scenarios(prompt):
    """Scenario markers only count at the start of the prompt, so markers
    embedded in a consultation prompt don't leak into the outer agent."""
    scenarios = set()
    for token in prompt.split():
        if token.startswith("SCENARIO:"):
            scenarios.add(token[len("SCENARIO:"):])
        else:
            break
    return scenarios


def _extract(prompt, key):
    for token in prompt.split():
        if token.startswith(key):
            return token[len(key):]
    return None


if __name__ == "__main__":
    sys.exit(main())
